# Local Postgres from docker-compose.yml. On Vercel, the Neon integration sets DATABASE_URL (and DATABASE_URL_UNPOOLED) per deployment.
DATABASE_URL=postgres://choreganizer:choreganizer@localhost:5433/choreganizer
# Signs session cookies: fill with `openssl rand -base64 32`. Vercel has its own value per environment.
BETTER_AUTH_SECRET=
