{
  "name": "choreganizer",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:auth-schema": "auth generate --config server/utils/auth.ts --output server/database/schema/auth.ts --yes && drizzle-kit generate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@vercel/functions": "^3.10.5",
    "@vueuse/integrations": "^14.4.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "h3": "^1.15.11",
    "nuxt": "^4.6.2",
    "pg": "^8.23.1",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.0",
    "@types/pg": "^8.23.1",
    "@types/sortablejs": "^1.15.9",
    "auth": "1.7.14",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
